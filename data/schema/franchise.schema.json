{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "franchise.schema.json",
  "title": "Franchise (프랜차이즈 / 시리즈)",
  "description": "data/franchises/<id>.json. 작품 묶음이자 캐릭터 정의의 단위. 즐겨찾기 단위.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "title", "characters", "sources", "meta"],
  "properties": {
    "$schema": {
      "const": "../schema/franchise.schema.json"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/Name"
    },
    "original_media": {
      "enum": ["manga", "light_novel", "novel", "web_novel", "game", "anime_original", "other"]
    },
    "wikipedia": {
      "$ref": "common.schema.json#/$defs/Wikipedia",
      "description": "위키백과 문서 (언어판별)"
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Character"
      }
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/Sources"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/RecordMeta"
    }
  },
  "$defs": {
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id",
          "description": "프랜차이즈 내 유일. 스포일러 캐릭터는 정체가 드러나지 않는 ID 사용"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/Name"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/Text",
          "description": "한 줄 소개"
        },
        "first_appearance": {
          "description": "이 사이트에 등록된 작품 중 첫 등장 작품 (목소리 유무 무관). 같은 프랜차이즈의 work id. 첫 음성 출연은 Credit에서 빌드 시 계산하므로 저장하지 않음",
          "type": "object",
          "additionalProperties": false,
          "required": ["work"],
          "properties": {
            "work": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "episode": {
              "type": "integer",
              "minimum": 1,
              "description": "첫 등장 화 (TV/OVA 등)"
            }
          }
        },
        "nameless": {
          "type": "boolean",
          "description": "고유 이름이 없는 배역 (예: 마을 사람 A, 학생). name에는 크레딧 표기를 넣음"
        },
        "spoiler": {
          "type": "boolean",
          "description": "true면 이름·설명·이미지를 '스포일러'로 가림. 성우는 그대로 표시"
        },
        "image": {
          "$ref": "common.schema.json#/$defs/Image",
          "description": "캐릭터 이미지 (공식 사이트 등 Tier 1~2 출처)"
        },
        "wikipedia": {
          "$ref": "common.schema.json#/$defs/Wikipedia",
          "description": "위키백과 문서 (언어판별)"
        }
      }
    }
  }
}
